# Fully offline configuration. No API keys are needed.
# Ollama runs locally on your computer.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval settings.
TOP_K=5
# Minimum cosine similarity (0-1) for a chunk to be used as context.
# Raise it if off-topic questions get answered; lower it if relevant
# questions return "not found".
RELEVANCE_THRESHOLD=0.45

# Keep debug on only for local development.
FLASK_DEBUG=true
MAX_CONTENT_LENGTH_MB=50
